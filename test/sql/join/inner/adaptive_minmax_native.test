# name: test/sql/join/inner/adaptive_minmax_native.test
# description: Adaptive filters use row frequency on persisted RLE and dictionary scans
# group: [inner]

require vector_size 2048

load {TEST_DIR}/adaptive_minmax_native.db readwrite v2.0.0

statement ok
SET force_compression='rle';

statement ok
CREATE TABLE numeric_build AS
SELECT 1::BIGINT AS w,1::BIGINT AS d,k,k>=2700 AS keep FROM range(1,3001) t(k);

statement ok
CREATE TABLE rle_frequency_probe AS
SELECT 1::BIGINT AS w,1::BIGINT AS d,
       CASE WHEN i%2048=0 THEN 1 ELSE 3000 END::BIGINT AS k,1::BIGINT AS n
FROM range(122880) t(i);

statement ok
CREATE TABLE rle_recovery_probe AS
SELECT 1::BIGINT AS w,1::BIGINT AS d,
       CASE WHEN i<12288 THEN 3000 ELSE 1 END::BIGINT AS k,1::BIGINT AS n
FROM range(122880) t(i);

statement ok
CREATE TABLE rle_null_probe AS
SELECT CASE WHEN i%2048=0 THEN NULL WHEN i%2048=1 THEN 1 ELSE 3000 END::BIGINT AS k
FROM range(122880) t(i);

statement ok
CHECKPOINT;

statement ok
SET force_compression='dict_fsst';

statement ok
CREATE TABLE string_build AS
SELECT w,d,lpad(k::VARCHAR,4,'0')||repeat('x',40) AS k,keep FROM numeric_build;

statement ok
CREATE TABLE dict_frequency_probe AS
SELECT w,d,lpad(k::VARCHAR,4,'0')||repeat('x',40) AS k,n FROM rle_frequency_probe;

statement ok
CREATE TABLE dict_recovery_probe AS
SELECT w,d,lpad(k::VARCHAR,4,'0')||repeat('x',40) AS k,n FROM rle_recovery_probe;

statement ok
CREATE TABLE dict_null_probe AS
SELECT lpad(k::VARCHAR,4,'0')||repeat('x',40) AS k FROM rle_null_probe;

statement ok
CHECKPOINT;

restart

statement ok
SET threads=1;

statement ok
SET disabled_optimizers='statistics_propagation,join_order,build_side_probe_side';

statement ok
SET dynamic_or_filter_threshold=0;

query I
SELECT count(*)>0 AND bool_and(compression='RLE') FROM pragma_storage_info('rle_frequency_probe')
WHERE column_name='k' AND segment_type<>'VALIDITY';
----
true

query I
SELECT count(*)>0 AND bool_and(compression='DICT_FSST') FROM pragma_storage_info('dict_frequency_probe')
WHERE column_name='k' AND segment_type<>'VALIDITY';
----
true

query II
SELECT count(*),sum(p.n) FROM rle_frequency_probe p JOIN numeric_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep;
----
122820	122820

# A run-value sample accepts half the runs, while almost every row passes.
query II
EXPLAIN (ANALYZE, FORMAT JSON)
SELECT count(*),sum(p.n) FROM rle_frequency_probe p JOIN numeric_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep;
----
analyzed_plan	<REGEX>:(?s).*"Table": "[^"]*rle_frequency_probe"[^}]*},\s*"intermediate_rows": 1228[3-7][0-9],.*

query II
SELECT count(*),sum(p.n) FROM dict_frequency_probe p JOIN string_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep;
----
122820	122820

query II
EXPLAIN (ANALYZE, FORMAT JSON)
SELECT count(*),sum(p.n) FROM dict_frequency_probe p JOIN string_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep;
----
analyzed_plan	<REGEX>:(?s).*"Table": "[^"]*dict_frequency_probe"[^}]*},\s*"intermediate_rows": 1228[3-7][0-9],.*

query II
SELECT count(*),sum(p.n) FROM rle_recovery_probe p JOIN numeric_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep;
----
12288	12288

# Six matching vectors and four paused vectors precede selective tail filtering.
query II
EXPLAIN (ANALYZE, FORMAT JSON)
SELECT count(*),sum(p.n) FROM rle_recovery_probe p JOIN numeric_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep;
----
analyzed_plan	<REGEX>:(?s).*"Table": "[^"]*rle_recovery_probe"[^}]*},\s*"intermediate_rows": 20480,.*

query II
SELECT count(*),sum(p.n) FROM dict_recovery_probe p JOIN string_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep;
----
12288	12288

query II
EXPLAIN (ANALYZE, FORMAT JSON)
SELECT count(*),sum(p.n) FROM dict_recovery_probe p JOIN string_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep;
----
analyzed_plan	<REGEX>:(?s).*"Table": "[^"]*dict_recovery_probe"[^}]*},\s*"intermediate_rows": 20480,.*

# Pausing optional filtering must still apply mandatory bounds to the same column.
query II
SELECT count(*),sum(p.n) FROM rle_frequency_probe p JOIN numeric_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep AND p.k<=2900;
----
0	NULL

query II
SELECT count(*),sum(p.n) FROM dict_frequency_probe p JOIN string_build b
ON p.w=b.w AND p.d=b.d AND p.k=b.k WHERE b.keep AND p.k<'2901';
----
0	NULL

query I
SELECT count(*) FROM rle_null_probe p JOIN numeric_build b ON p.k=b.k WHERE b.keep AND p.k>=2000;
----
122760

query I
SELECT count(*) FROM dict_null_probe p JOIN string_build b ON p.k=b.k WHERE b.keep AND p.k>='2000';
----
122760

query II
SELECT (SELECT count(*) FROM rle_null_probe WHERE k IS NULL),
       (SELECT count(*) FROM dict_null_probe WHERE k IS NULL);
----
60	60

statement ok
RESET disabled_optimizers;

statement ok
RESET dynamic_or_filter_threshold;
