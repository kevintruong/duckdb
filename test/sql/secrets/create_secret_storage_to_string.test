# name: test/sql/secrets/create_secret_storage_to_string.test
# description: Secret storage clauses survive statement stringification
# group: [secrets]

# Keep the in-memory setup and inspection in one database instance.
statement ok
BEGIN;

statement ok
SET debug_verify_statement='reparse_statement';

statement ok
CREATE SECRET default_storage IN memory (TYPE http);

statement ok
CREATE TEMPORARY SECRET temporary_storage IN memory (TYPE http);

statement ok
CREATE OR REPLACE SECRET "secret with space" IN "memory" (TYPE http);

query TT
SELECT name, storage FROM duckdb_secrets() ORDER BY name;
----
default_storage	memory
secret with space	memory
temporary_storage	memory

statement error
CREATE PERSISTENT SECRET invalid_type IN local_file (TYPE test_missing_type);
----
Secret type "test_missing_type" not found

statement ok
ROLLBACK;

statement ok
RESET debug_verify_statement;
